# Copy to .env and adjust as needed.

# Disable system parts. Set to "true" (or "1"/"yes") to disable a feature.
NEXT_PUBLIC_DISABLE_COMPLAINTS=false
NEXT_PUBLIC_DISABLE_IT_TICKETS=false
NEXT_PUBLIC_DISABLE_MAINTENANCE_TICKETS=false

# Secret used to sign admin session cookies.
# SESSION_SECRET=change-me

# Seed values for the service-provider company shown on the Ordem de Serviço
# (Service Order) PDF header. Only used on first boot; afterwards edit the
# company in the admin panel (/admin/company).
# COMPANY_NAME=
# COMPANY_CNPJ=
# COMPANY_ADDRESS=
# COMPANY_PHONE=
