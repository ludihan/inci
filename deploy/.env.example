# Server-side configuration for deploy/docker-compose.yml. Copy to .env in the
# deploy directory on the server (chmod 600) — it never goes through Jenkins.

# Image to run. INCI_TAG is rewritten by deploy.sh on every deploy.
INCI_IMAGE=registry.example.com/inci
INCI_TAG=latest

# Public hostname (DNS must point here) and the e-mail for Let's Encrypt.
DOMAIN=inci.example.com
ACME_EMAIL=admin@example.com

# Required. Generate once with `openssl rand -base64 48` and NEVER change it:
# it also hashes the stored matrículas (see README).
SESSION_SECRET=

# Optional: proof-of-work difficulty for public forms (see lib/pow.ts).
# POW_DIFFICULTY=

# Seed values for the first service-provider company (first boot only).
# COMPANY_NAME=
# COMPANY_CNPJ=
# COMPANY_ADDRESS=
# COMPANY_PHONE=
